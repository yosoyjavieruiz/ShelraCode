{
  "name": "localcode",
  "version": "0.1.0",
  "description": "A local-first, privacy-aware AI coding agent for the terminal.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "localcode": "src/index.ts"
  },
  "scripts": {
    "localcode": "bun --conditions=browser run src/index.ts",
    "dev": "bun --conditions=browser run src/index.ts",
    "dev:tui": "bun --conditions=browser run src/index.ts --tui",
    "setup": "bun --conditions=browser run src/index.ts setup",
    "doctor": "bun --conditions=browser run src/index.ts doctor",
    "models": "bun --conditions=browser run src/index.ts models",
    "providers": "bun --conditions=browser run src/index.ts providers",
    "config": "bun --conditions=browser run src/index.ts config",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "test:functional": "bun --conditions=browser test tests/integration/functional-acceptance.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "logs:inspect": "bun run scripts/inspect-agent-log.ts",
    "build": "bun run scripts/build.ts",
    "smoke": "bun run scripts/smoke.ts",
    "catalog:refresh": "bun run scripts/refresh-model-catalog.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.7",
    "@opentui/keymap": "0.5.7",
    "@opentui/solid": "0.5.7",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
