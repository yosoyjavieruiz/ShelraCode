{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SHELRA_AUDIT_MODE": "true",
    "SHELRA_ALLOW_PROD": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/production-modification-guard.ts"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/evidence-guard.ts"
          }
        ]
      }
    ]
  }
}
