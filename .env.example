# LocalCode never assumes that an API key implies free or privacy-safe access.
# Set the confirmation flags only after verifying the provider account policy.
GROQ_API_KEY=
GROQ_FREE_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_FREE_CONFIRMED=false
OPENROUTER_ZDR_CONFIRMED=false
OPENCODE_API_KEY=
LOCALCODE_OPENAI_BASE_URL=
LOCALCODE_OLLAMA_URL=http://127.0.0.1:11434
LOCALCODE_LM_STUDIO_URL=http://127.0.0.1:1234/v1
LOCALCODE_LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LOCALCODE_STATE_DIR=
LOCALCODE_PRIVACY=private
LOCALCODE_ROUTING_MODE=strict-zero
# Structured JSONL logs are off by default. Use a workspace-local path while testing.
LOCALCODE_LOG_LEVEL=off
LOCALCODE_LOG_PATH=
LOCALCODE_LOG_STDERR=0
LOCALCODE_AGENT_TRACE=0
