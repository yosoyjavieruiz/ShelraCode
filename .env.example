# Cloud keys authenticate requests; they do not require a paid subscription.
# Never commit real values. In strict-zero ShelraCode never upgrades, falls
# back to, or selects a paid route.
GROQ_API_KEY=
# Optional account confirmation. Groq works in quota-bearing Free mode without
# this flag; set true only when the account's free policy was checked.
GROQ_FREE_CONFIRMED=false
# Remote private-repository use still needs an explicit privacy/ZDR decision.
GROQ_ZDR_CONFIRMED=false
OPENROUTER_API_KEY=
# Discovery is hard-filtered to :free/openrouter/free/zero-priced entries.
# This compatibility flag is not required for those model records.
OPENROUTER_FREE_CONFIRMED=false
# Remote private-repository use still needs an explicit privacy/ZDR decision.
OPENROUTER_ZDR_CONFIRMED=false
OPENCODE_API_KEY=
SHELRACODE_OPENAI_BASE_URL=
SHELRACODE_OLLAMA_URL=http://127.0.0.1:11434
SHELRACODE_LM_STUDIO_URL=http://127.0.0.1:1234/v1
SHELRACODE_LLAMA_CPP_URL=http://127.0.0.1:8080/v1
SHELRACODE_STATE_DIR=
SHELRACODE_PRIVACY=private
SHELRACODE_ROUTING_MODE=strict-zero
# Structured JSONL logs are off by default. Use a workspace-local path while testing.
SHELRACODE_LOG_LEVEL=off
SHELRACODE_LOG_PATH=
SHELRACODE_LOG_STDERR=0
SHELRACODE_AGENT_TRACE=0
